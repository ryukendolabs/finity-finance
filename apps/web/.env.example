# Finity web app (Solana devnet). Copy to .env.local for local development.
#
# The browser reaches Solana through this app's /api/rpc proxy, which forwards to SOLANA_RPC_URL on the server
# (e.g. a QuickNode devnet endpoint), so a private RPC key never reaches the client. Unset: public devnet RPC.
SOLANA_RPC_URL=
# Optional: a public endpoint the browser may call directly instead of the proxy, and its websocket.
NEXT_PUBLIC_SOLANA_RPC_URL=
NEXT_PUBLIC_SOLANA_WS_URL=
# Alerts: session signing secret (generated into ~/.config/finity/session_secret when unset) and inbox path.
FINITY_SESSION_SECRET=
FINITY_DB=
# Alert delivery (also read by the keeper's notifier): email and Telegram are off when unset; browser push needs nothing.
SMTP_URL=
SMTP_FROM=
TELEGRAM_BOT_TOKEN=
# Base URL used in alert links.
FINITY_APP_URL=http://localhost:3000
# Finity V2 (the Mainnet page): a private mainnet RPC for the /api/rpc/mainnet proxy (unset: public mainnet RPC).
# To rehearse against the devnet deployment instead: V2_RPC_URL=https://api.devnet.solana.com and
# NEXT_PUBLIC_V2_CLUSTER=devnet.
V2_RPC_URL=
NEXT_PUBLIC_V2_CLUSTER=
