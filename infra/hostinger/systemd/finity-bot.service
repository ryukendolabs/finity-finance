[Unit]
Description=Finity protocol keeper (prices, market hours, auctions)
After=network-online.target
Wants=network-online.target

[Service]
User=finity
Group=finity
EnvironmentFile=/home/finity/.config/finity/env
Environment=HOME=/home/finity
Environment=NODE_ENV=production
Environment=NODE_NO_WARNINGS=1
WorkingDirectory=/opt/finity/backend
Environment=RELAYER_URLS=http://127.0.0.1:7701,http://127.0.0.1:7702,http://127.0.0.1:7703
ExecStart=/opt/node/bin/node /opt/finity/backend/bot.mjs
Restart=always
RestartSec=10
MemoryMax=384M
# Hardening: the services only write their own data and settings folders.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/home/finity/.local/share/finity /home/finity/.config/finity
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
