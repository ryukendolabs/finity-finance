[Unit]
Description=Finity web app on 127.0.0.1:3100
After=network-online.target
Wants=network-online.target

[Service]
User=finity
Group=finity
EnvironmentFile=/home/finity/.config/finity/env
Environment=HOME=/home/finity
Environment=NODE_ENV=production
Environment=NODE_NO_WARNINGS=1
WorkingDirectory=/opt/finity/web/apps/web
Environment=PORT=3100
Environment=HOSTNAME=127.0.0.1
ExecStart=/opt/node/bin/node server.js
Restart=always
RestartSec=10
MemoryMax=512M
# Hardening: the services only write their own data and settings folders.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/home/finity/.local/share/finity /home/finity/.config/finity
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
