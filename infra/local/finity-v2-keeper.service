[Unit]
Description=Finity V2 keeper (mainnet): mirrors the devnet Asset Clock, safe LTV and prices into Finity V2
After=network-online.target finity-bot.service
Wants=network-online.target

[Service]
# V2_RPC_URL (a mainnet RPC), SOLANA_RPC_URL (the devnet one it reads) and the V2_* knobs; never committed.
EnvironmentFile=-%h/.config/finity/env
WorkingDirectory=@REPO@/solana
Environment=PATH=@NODE_BIN@:/usr/local/bin:/usr/bin:/bin
# Market authority and fee payer: ~/.config/finity/mainnet-authority.json (or V2_WALLET).
ExecStart=@NODE_BIN@/pnpm -s v2 keeper --cluster @V2_CLUSTER@
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
